// Nebula Dawn — the light half of NeoPad's sample theme plugin.
{
  "name": "Nebula Dawn",
  "type": "light",
  "colors": {
    "editor.background": "#faf8ff",
    "editor.foreground": "#3b3653",
    "editorCursor.foreground": "#6e56cf",
    "editor.selectionBackground": "#d9cffb",
    "editor.lineHighlightBackground": "#f3effc",
    "editorLineNumber.foreground": "#b3adc9",
    "editorLineNumber.activeForeground": "#5c5675",
    "editorIndentGuide.background1": "#e6e0f5",
    "editorWhitespace.foreground": "#d6d0e8",
    "editorBracketMatch.border": "#6e56cf80",
    "editorWidget.background": "#f1edfb",
    "editorWidget.border": "#ded7f0",

    "focusBorder": "#6e56cf",
    "textLink.foreground": "#2f5fd0",
    "textBlockQuote.border": "#ded7f0",
    "textCodeBlock.background": "#f1edfb",

    "sideBar.background": "#f1edfb",
    "tab.activeBackground": "#faf8ff",
    "tab.inactiveBackground": "#f1edfb",
    "tab.hoverBackground": "#ebe5f8",
    "tab.border": "#ded7f0",

    "terminal.background": "#f6f3fe",
    "terminal.foreground": "#3b3653",
    "terminalCursor.foreground": "#6e56cf",
    "terminal.ansiBlack": "#3b3653",
    "terminal.ansiRed": "#c2185b",
    "terminal.ansiGreen": "#1a7f5a",
    "terminal.ansiYellow": "#a86100",
    "terminal.ansiBlue": "#2f5fd0",
    "terminal.ansiMagenta": "#8a3ffc",
    "terminal.ansiCyan": "#00799e",
    "terminal.ansiWhite": "#d6d0e8",
    "terminal.ansiBrightBlack": "#8e88a8",
    "terminal.ansiBrightRed": "#e0457b",
    "terminal.ansiBrightGreen": "#2a9d73",
    "terminal.ansiBrightYellow": "#c47a10",
    "terminal.ansiBrightBlue": "#4c7ae8",
    "terminal.ansiBrightMagenta": "#a066ff",
    "terminal.ansiBrightCyan": "#1a98bd",
    "terminal.ansiBrightWhite": "#faf8ff"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8e88a8", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#8a3ffc" } },
    { "scope": ["keyword.operator", "punctuation.accessor"], "settings": { "foreground": "#00799e" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#1a7f5a" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "#c2185b" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other"], "settings": { "foreground": "#c4501a" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call.generic"], "settings": { "foreground": "#2f5fd0" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#a86100" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#b03a6f" } },
    { "scope": ["variable.language", "support.variable"], "settings": { "foreground": "#c2185b" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#c2185b" } },
    { "scope": ["entity.other.attribute-name", "support.type.property-name"], "settings": { "foreground": "#a86100" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#6b6585" } },
    { "scope": ["invalid"], "settings": { "foreground": "#d0021b", "fontStyle": "underline" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#2f5fd0", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#a86100", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#8a3ffc", "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"], "settings": { "foreground": "#1a7f5a" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#2f5fd0" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#8e88a8", "fontStyle": "italic" } },
    { "scope": ["markup.list", "punctuation.definition.list"], "settings": { "foreground": "#8a3ffc" } }
  ]
}
