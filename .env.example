# NeoPad code-signing credentials
# Copy this file to .env and fill in your values.
# .env is git-ignored and must NEVER be committed.

# Full certificate name from Keychain
# Find with: security find-identity -v -p codesigning
NEOPAD_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Apple ID that owns the Developer Program membership
NEOPAD_APPLE_ID="you@example.com"

# 10-character Team ID (shown in parentheses in the certificate name)
NEOPAD_TEAM_ID="ABCD123456"

# App-specific password generated at appleid.apple.com
# Sign in → App-Specific Passwords → Generate
NEOPAD_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
